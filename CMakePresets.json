{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "vcpkg-base",
      "hidden": true,
      "description": "Dependencies from vcpkg (manifest mode). Requires the VCPKG_ROOT environment variable.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "debug",
      "displayName": "Debug (vcpkg)",
      "inherits": "vcpkg-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release (vcpkg)",
      "inherits": "vcpkg-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "ci",
      "displayName": "CI (vcpkg, release, warnings as errors)",
      "inherits": "release",
      "cacheVariables": { "CUTLINE_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "system-debug",
      "displayName": "Debug (system packages, no vcpkg)",
      "description": "Uses Qt and Catch2 already installed on the machine, e.g. from a Linux distribution.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CUTLINE_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "system-debug", "configurePreset": "system-debug" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "environment": { "QT_QPA_PLATFORM": "offscreen" }
    },
    { "name": "debug", "inherits": "test-base", "configurePreset": "debug" },
    { "name": "release", "inherits": "test-base", "configurePreset": "release" },
    { "name": "ci", "inherits": "test-base", "configurePreset": "ci" },
    { "name": "system-debug", "inherits": "test-base", "configurePreset": "system-debug" }
  ]
}
